{
  "name": "evan-os",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder --win",
    "electron:build:dir": "npm run build && electron-builder --win --dir",
    "test": "npm run test:core && npm run test:search && npm run test:relation && npm run test:graph && npm run test:memory && npm run test:context && npm run test:agents && npm run test:workflow && npm run test:integrations && npm run test:business && npm run test:system && npm run test:vault",
    "test:core": "tsx test-core.ts",
    "test:search": "tsx test-search.ts",
    "test:relation": "tsx test-relation.ts",
    "test:graph": "tsx test-graph.ts",
    "test:memory": "tsx test-memory.ts",
    "test:context": "tsx test-context.ts",
    "test:agents": "tsx test-agents.ts",
    "test:workflow": "tsx test-workflow.ts",
    "test:integrations": "tsx test-integrations.ts",
    "test:business": "tsx test-business.ts",
    "test:system": "tsx test-system.ts",
    "test:vault": "tsx test-vault.ts"
  },
  "build": {
    "appId": "com.evan.os",
    "productName": "Evan OS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/favicon.svg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@uiw/react-md-editor": "^4.1.2",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "remark-gfm": "^4.0.1",
    "vite-plugin-singlefile": "^1.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
